      "has_footer": 1,
      "footer": "<div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; padding: 40px 20px; gap: 30px;\">\r\n  <div style=\"flex: 1; min-width: 280px;\">\r\n    <h3>🚀 Loopar</h3>\r\n    <p>The meta-framework for building full-stack applications visually. Create complete apps with drag-and-drop, no complex setup required.</p>\r\n    <p><strong>📦 GitHub:</strong> <a href=\"https://github.com/alphabit-technology/loopar\">github.com/alphabit-technology/loopar</a></p>\r\n    <p><strong>✉️ Contact:</strong> <a href=\"mailto:hello@loopar.build\">[hello@loopar.build](mailto\\:hello@loopar.build)</a></p>\r\n  </div>\r\n\r\n  <div style=\"flex: 1; min-width: 280px;\">\r\n    <h3>⚡ Features</h3>\r\n\r\n    <ul>\r\n      <li>Visual drag-and-drop builder</li>\r\n      <li>Auto-recursive Entity architecture</li>\r\n      <li>Multi-database support (MySQL, PostgreSQL, SQLite)</li>\r\n      <li>Multi-tenant ready</li>\r\n      <li>React + Vite + Tailwind CSS</li>\r\n      <li>Zero-config deployment</li>\r\n    </ul>\r\n  </div>\r\n\r\n  <div style=\"flex: 1; min-width: 280px;\">\r\n    <h3>📚 Resources</h3>\r\n\r\n    <ul>\r\n      <li><a href=\"/doc\">Documentation</a></li>\r\n      <li><a href=\"/doc/getting-started\">Getting Started</a></li>\r\n      <li><a href=\"/doc/Concepts\">Concepts</a></li>\r\n      <li><a href=\"https://github.com/alphabit-technology/loopar-framework/discussions\">Community</a></li>\r\n    </ul>\r\n  </div>\r\n</div>",
      "has_copyright": 1,
